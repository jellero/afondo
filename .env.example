# Storage locale (default: data/afondo.sqlite3)
AFONDO_DB_PATH=data/afondo.sqlite3
# Necessario soltanto per rivedere/approvare prove:
# AFONDO_REVIEW_TOKEN=GENERATE_A_LONG_RANDOM_SECRET

# Pannello /admin. Generare un token robusto e una Fernet key:
# python -c "import secrets; print(secrets.token_urlsafe(40))"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AFONDO_ADMIN_TOKEN=...
# AFONDO_ENCRYPTION_KEY=...

# Worker locali opzionali: OFF di default, verificare diritti e costi.
# AFONDO_ENABLE_PREANALYSIS=1
# AFONDO_PREANALYSIS_INTERVAL_SECONDS=900
# AFONDO_ENABLE_SOURCE_SYNC=1
# AFONDO_SOURCE_SYNC_INTERVAL_SECONDS=3600
